  "description": "The dynamic, fluid companion framework to Interpretable Context Methodology (ICM) for knowledge work and creative discovery",
  "type": "module",
  "bin": {
    "cca": "./scripts/cca.js"
  },
  "scripts": {
    "status": "node ./scripts/cca.js status",
